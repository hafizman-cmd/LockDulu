generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

enum GarmentStatus {
  AVAILABLE
  LOCKED
  PENDING_VERIFICATION
  SOLD
  HOLD_BOX
}

enum DropStatus {
  UPCOMING
  LIVE
  ENDED
}

enum GarmentCategory {
  Tee
  Jacket
  Shirt
  Pants
  Sweatshirt
}

enum ConditionGrade {
  DEADSTOCK
  LIKE_NEW
  VINTAGE_FADE
  DISTRESSED
}

enum FulfillmentType {
  SHIP_NOW
  HOLD_BOX
}

enum PaymentStatus {
  AWAITING_RECEIPT
  PENDING_VERIFICATION
  VERIFIED_PAID
  REJECTED
  EXPIRED
}

enum ShopStatus {
  ACTIVE
  HELD
  DELETED
}

model Seller {
  id             String   @id @default(cuid())
  storeName      String
  storeSlug      String   @unique
  bio            String
  bannerImageUrl String?
  whatsappNumber String
  qrCodeUrl      String
  qrAccountName  String
  qrBankLabel    String
  holdBoxDays    Int      @default(7)
  shippingFee    Decimal  @default(8.00)
  passwordHash   String
  status         ShopStatus @default(ACTIVE)
  nextItemNumber Int      @default(1)
  createdAt      DateTime @default(now())
  drops          Drop[]
  garments       Garment[]
  orders         Order[]
}

model Drop {
  id          String     @id @default(cuid())
  sellerId    String
  seller      Seller     @relation(fields: [sellerId], references: [id])
  title       String
  scheduledAt DateTime
  status      DropStatus
  garments    Garment[]

  @@index([sellerId, status, scheduledAt])
}

model Garment {
  id               String          @id @default(cuid())
  sellerId         String
  seller           Seller          @relation(fields: [sellerId], references: [id])
  dropId           String?
  drop             Drop?           @relation(fields: [dropId], references: [id])
  publishRequestId String?
  code             String
  title            String
  brand            String
  category         GarmentCategory
  price            Decimal
  pitInches        Float
  lengthInches     Float
  conditionGrade   ConditionGrade
  conditionNotes   String
  images           Json
  flawPins         Json
  status           GarmentStatus   @default(AVAILABLE)
  hidden           Boolean         @default(false)
  deletedAt        DateTime?
  lockedUntil      DateTime?
  lockSessionToken String?
  orderItem        OrderItem?

  @@unique([sellerId, code])
  @@unique([sellerId, publishRequestId])
  @@index([sellerId, status, lockedUntil])
  @@index([dropId])
}

model Order {
  id                  String          @id @default(cuid())
  sellerId            String
  seller              Seller          @relation(fields: [sellerId], references: [id])
  buyerName           String          @default("")
  buyerPhone          String          @default("")
  shippingAddress     String          @default("")
  fulfillmentType     FulfillmentType @default(SHIP_NOW)
  totalAmount         Decimal
  itemAmount          Decimal
  shippingFee         Decimal
  holdBoxDays         Int
  qrCodeUrl           String
  qrAccountName       String
  qrBankLabel         String
  garmentCode         String
  garmentTitle        String?
  buyerAccessHash     String          @unique
  receiptImageUrl     String?
  paymentStatus       PaymentStatus   @default(AWAITING_RECEIPT)
  createdAt           DateTime        @default(now())
  verifiedAt          DateTime?
  receiptSubmittedAt  DateTime?
  reviewedAt          DateTime?
  rejectionReason     String?
  dispatchRequestedAt DateTime?
  dispatchGroupId     String?
  shippedAt           DateTime?
  shipmentUnconfirmed Boolean         @default(false)
  shipmentReconciledAt DateTime?
  transferReference   String?
  transferReportedAt  DateTime?
  transferResolvedAt  DateTime?
  transferResolution  String?
  transferVersion     Int             @default(0)
  transferEscalatedAt DateTime?
  refundAmount        Decimal?
  refundSentOn        String?
  refundReference     String?
  refundNote          String?
  refundDisputedAt    DateTime?
  transferEvents      TransferEvent[]
  items               OrderItem[]

  @@index([sellerId, paymentStatus])
  @@index([buyerPhone, paymentStatus])
  @@index([sellerId, dispatchGroupId])
  @@index([transferEscalatedAt, transferResolvedAt])
}

model TransferEvent {
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  version   Int
  kind      String
  createdAt DateTime @default(now())
  detail    String?

  @@id([orderId, version])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  garmentId String  @unique
  garment   Garment @relation(fields: [garmentId], references: [id])

  @@index([orderId])
}

model RequestBudget {
  key       String @id
  count     Int
  expiresAt BigInt

  @@index([expiresAt])
}
